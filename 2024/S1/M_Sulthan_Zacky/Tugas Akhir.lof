\contentsline {figure}{\numberline {1.5}{\ignorespaces Siklus Carnot pada bidang F,L. Siklus ini terdiri dari 4 segmen yang reversibel. \(AB\) adalah ekspansi isoenergetik, \(BC\) adalah ekspansi adiabatis, \(CD\) adalah kompresi isotermal, dan \(DA\) adalah kompresi adiabatis. \cite {Bender2000Quantum}}}{18}{figure.caption.8}%
\contentsline {figure}{\numberline {1.6}{\ignorespaces \textit {power output} tak berdimensi \(P^*\) terhadap \(r\) pada siklus Carnot kuantum.}}{21}{figure.caption.9}%
\contentsline {figure}{\numberline {1.7}{\ignorespaces Efisiensi \(\eta \) terhadap \(r\) pada siklus Carnot kuantum dengan variasi pada nilai \(\beta \).}}{21}{figure.caption.10}%
\contentsline {figure}{\numberline {1.8}{\ignorespaces \textit {power output} tak berdimensi \(P^*\) terhadap efisiensi \(\eta \) pada siklus Carnot kuantum dengan variasi pada nilai \(\beta \).}}{22}{figure.caption.11}%
\contentsline {figure}{\numberline {1.9}{\ignorespaces Siklus Otto pada bidang F,L. Siklus ini terdiri dari 4 segmen yang reversibel. \(AB\) adalah pembakaran isovolume, \(BC\) adalah ekspansi adiabatis, \(CD\) adalah pembuangan isovolume, dan \(DA\) adalah kompresi adiabatis. \cite {Thomas2011Coupled}}}{23}{figure.caption.12}%
\contentsline {figure}{\numberline {1.10}{\ignorespaces \textit {power output} tak berdimensi \(P^*\) terhadap \(r\) pada siklus Otto kuantum.}}{25}{figure.caption.13}%
\contentsline {figure}{\numberline {1.11}{\ignorespaces Efisiensi \(\eta \) terhadap \(r\) pada siklus Otto kuantum dengan variasi terhadap parameter disipasi \(\beta \).}}{25}{figure.caption.14}%
\contentsline {figure}{\numberline {1.12}{\ignorespaces \textit {power output} tak berdimensi \(P^*\) terhadap efisiensi \(\eta \) pada siklus Otto kuantum dengan variasi terhadap parameter disipasi \(\beta \).}}{26}{figure.caption.15}%
\contentsline {figure}{\numberline {1.13}{\ignorespaces Siklus Brayton pada bidang F,L. Siklus ini terdiri dari 4 segmen reversibel. \(AB\) adalah ekspansi isobarik, \(BC\) adalah ekspansi adiabatis, \(CD\) adalah kompresi isobarik, dan \(DA\) adalah kompresi adiabatis. \cite {Huang2013Brayton}}}{27}{figure.caption.16}%
\contentsline {figure}{\numberline {1.14}{\ignorespaces \textit {power output} tak berdimensi \(P^*\) terhadap \(r\) pada siklus Brayton kuantum.}}{29}{figure.caption.17}%
\contentsline {figure}{\numberline {1.15}{\ignorespaces Efisiensi \(\eta \) terhadap \(r\) pada siklus Brayton kuantum dengan variasi terhadap parameter disipasi \(\beta \).}}{29}{figure.caption.18}%
\contentsline {figure}{\numberline {1.16}{\ignorespaces \textit {power output} tak berdimensi \(P^*\) terhadap efisiensi \(\eta \) pada siklus Brayton kuantum dengan variasi terhadap parameter disipasi \(\beta \).}}{30}{figure.caption.19}%
